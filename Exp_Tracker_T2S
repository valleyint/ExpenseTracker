    def save(self) :
        fexp = open("expnese_file","wb+")
        pickle.dump(self.expenses, fexp)
        fexp.close()

        fin = open("income_file","wb+")
        pickle.dump(self.incomes, fin)
        fin.close()

    def load(self) :
        fexp = open("expnese_file","rb+")
        self.expenses = pickle.load(fexp)
        fexp.close()

        fin = open("income_file","rb+")
        self.incomes = pickle.load(fin)
        fin.close()



class stocks :
    def __init__ (self,key):
        self.api_key = key
        self.owned = []
        
    def addStock (self,symbol,exchange:str, count, tm:dt.datetime, note='') :
        self.owned.append([symbol,count,exchange,tm,note])
    
    def remove(self,symbol,exchange) :
        for loop in range(len(self.owned)) :
            if self.owned[loop][0] == symbol and self.owned[loop][2] == exchange :
                self.owned.pop(loop)
    
    def update(self,symbol,exchange:str, count) :
        for loop in range(len(self.owned)) :
            if self.owned[loop][0] == symbol and self.owned[loop][2] == exchange :
                self.owned[loop][1] = count

    def count (self,symbol,exchange) :
        for loop in range(len(self.owned)) :
            if self.owned[loop][0] == symbol and self.owned[loop][2] == exchange :
                return self.owned[loop][1]
    
    def unmarshal_csv (self,datastr):
        arr = [[],[],[],[],[],[]]

        splitdata = datastr.split('\n')
        for loop in range(1,len(splitdata)-1):
            r = splitdata[loop].strip('\r')
            splitrow = r.split(',')

            arr[0].append(dt.datetime.strptime(splitrow[0],'%Y-%m-%d'))
            for loop1 in range(1,len(splitrow)):
                arr[loop1].append(float(splitrow[loop1]))
        return arr

    

    # possible values for timeframe: "month", "day"
    def getPrice (self,symbol,exhange,timeframe:str):
        sd =[]
        for loop in self.owned :
            if loop[0] == symbol and loop[2]==exhange:
                sd = loop
        
        ext=''
        if sd[2] != '' :
            ext = '.'+sd[2]
        
        cmd=''        
        if timeframe == "day":
            cmd = 'https://www.alphavantage.co/query?function=TIME_SERIES_DAILY&symbol={}&outputsize=compact&datatype=csv&apikey={}'.format(symbol+ext,self.api_key)
        elif timeframe == "month":
            cmd = 'https://www.alphavantage.co/query?function=TIME_SERIES_MONTHLY&symbol={}&outputsize=compact&datatype=csv&apikey={}'.format(symbol+ext,self.api_key)
        r = requests.get(cmd)

        return self.unmarshal_csv(r.text)
    
