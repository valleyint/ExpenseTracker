    def intro(self):
        self.frame1 = tk.Frame(self.root)
        self.label_header = tk.Label(self.frame1, text="EXPENSES TRACKER", font=("Arial", 60), bg="#2C323A", fg="#F2DFCB")
        self.label_header.grid()
        self.frame1.grid()
        self.frame2 = tk.Frame(self.root, bg="#2C323A")
        self.entry = tk.Entry(self.root)
        self.create_buttons()
        self.frame2.grid(pady=70, sticky="w", padx=50)

    def create_buttons(self):
        for i in range(1, len(self.buttons)):
            self.buttons[i][1] = tk.Button(self.frame2, text=self.buttons[i][0], command=lambda i=i: self.button_command(self.buttons[0], i), padx=10, pady=5, width=15, bg="#1C1B23", fg="#F2DFCB", activebackground="#F2DFCB", activeforeground="#1C1B23")
            self.buttons[i][1].grid(row=i, column=0, pady=(self.root.winfo_screenheight()) / 30)

    def delete_buttons(self):
        for i in range(len(self.buttons), 1, -1):
            if isinstance(self.buttons[i-1][1], tk.Button):
                self.buttons[i-1][1].destroy()
                self.buttons.pop()

    def button_command(self, seq, num):
        if seq == 1:
            if num == 1:
                self.setup_income_buttons()
            elif num == 2:
                self.setup_expense_buttons()
            elif num == 3:
                self.setup_graph_buttons()
            else:
                self.root.destroy()
        elif seq in [11, 12]:
            self.handle_income_expense_buttons(num)
        elif seq == 13:
            self.handle_graph_buttons(num)

    def setup_income_buttons(self):
        self.income_or_expense = "Income"
        self.delete_buttons()
        self.buttons = [11, [BUTTON_LABELS["BACK"], 0], [BUTTON_LABELS["ADD"] + " " + BUTTON_LABELS["INCOME"], 0], [BUTTON_LABELS["REMOVE"] + " " + BUTTON_LABELS["INCOME"], 0], [BUTTON_LABELS["UPDATE"] + " " + BUTTON_LABELS["INCOME"], 0], [BUTTON_LABELS["GET"] + " " + BUTTON_LABELS["INCOME"], 0]]
        self.create_input_frame()

    def setup_expense_buttons(self):
        self.income_or_expense = "Expense"
        self.delete_buttons()
        self.buttons = [11, [BUTTON_LABELS["BACK"], 0], [BUTTON_LABELS["ADD"] + " " + BUTTON_LABELS["EXPENSE"], 0], [BUTTON_LABELS["REMOVE"] + " " + BUTTON_LABELS["EXPENSE"], 0], [BUTTON_LABELS["UPDATE"] + " " + BUTTON_LABELS["EXPENSE"], 0], [BUTTON_LABELS["GET"] + " " + BUTTON_LABELS["EXPENSE"], 0]]
        self.create_input_frame()

    def setup_graph_buttons(self):
        self.delete_buttons()
        self.buttons = [13, [BUTTON_LABELS["BACK"], 0], [BUTTON_LABELS["GRAPHS"], 0]]
        self.create_graph_frame()

    def create_input_frame(self):
        # Create input fields and buttons for adding/removing/updating income/expense
        self.input_frame = tk.Frame(self.root, bg="#2C323A")
        self.input_label = tk.Label(self.input_frame, text=f"Enter {self.income_or_expense} Details:", bg="#2C323A", fg="#F2DFCB")
        self.input_label.grid(row=0, column=0)
        self.input_entry = tk.Entry(self.input_frame)
        self.input_entry.grid(row=0, column=1)
        self.input_frame.grid(pady=20)

        for i in range(1, len(self.buttons)):
            self.buttons[i][1] = tk.Button(self.input_frame, text=self.buttons[i][0], command=lambda i=i: self.handle_input_buttons(i), padx=10, pady=5, bg="#1C1B23", fg="#F2DFCB")
            self.buttons[i][1].grid(row=0, column=i, pady=5)

    def handle_input_buttons(self, num):
        # Handle actions for add/remove/update buttons
        if num == 1:  # Back
            self.intro()
        elif num == 2:  # Add
            self.add_income_expense()
        elif num == 3:  # Remove
            self.remove_income_expense()
        elif num == 4:  # Update
